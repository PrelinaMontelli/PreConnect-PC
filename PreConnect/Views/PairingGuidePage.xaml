<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PreConnect.Views.PairingGuidePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:PreConnect.Views"
    mc:Ignorable="d"
    Language="zh-CN"
    NavigationCacheMode="Required"
    FontFamily="Microsoft YaHei UI">

    <Grid Padding="24" RowSpacing="16">
        <Grid.Background>
            <RadialGradientBrush Center="0.5,0.45" RadiusX="0.9" RadiusY="0.9">
                <GradientStop Color="#0D5A98FF" Offset="0" />
                <GradientStop Color="#00000000" Offset="1" />
            </RadialGradientBrush>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Viewbox Stretch="Uniform" MaxWidth="520" MaxHeight="520"
                 HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border Width="420" Height="420"
                    CornerRadius="24"
                    Background="White"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="2"
                    Padding="22">
                <Image Source="{x:Bind ViewModel.QrCodeImage, Mode=OneWay}"
                       Stretch="Uniform"
                       HorizontalAlignment="Stretch"
                       VerticalAlignment="Stretch" />
            </Border>
        </Viewbox>

        <StackPanel Grid.Row="1" HorizontalAlignment="Center" Spacing="8">
            <Button Content="刷新二维码" Click="RefreshPin_Click" MinWidth="140" />
            <TextBlock Text="{x:Bind ViewModel.PinExpiryText, Mode=OneWay}"
                       HorizontalAlignment="Center"
                       FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
    </Grid>
</Page>