<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PreConnect.Views.StartPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:PreConnect.Views"
    mc:Ignorable="d"
    Language="zh-CN"
    NavigationCacheMode="Required"
    FontFamily="Microsoft YaHei UI">

    <Grid Padding="20,16,20,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶部状态栏：服务状态 + 端点 + 控制按钮 -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Ellipse Width="10" Height="10"
                         Fill="{x:Bind ViewModel.StatusDotBrush, Mode=OneWay}"
                         VerticalAlignment="Center" />
                <TextBlock Text="{x:Bind ViewModel.ServiceStatus, Mode=OneWay}"
                           FontSize="20" FontWeight="SemiBold" />
            </StackPanel>

            <TextBlock Grid.Column="1"
                       Text="{x:Bind ViewModel.Endpoint, Mode=OneWay}"
                       FontFamily="Consolas" FontSize="12"
                       VerticalAlignment="Center" HorizontalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                <Button Content="启动服务" Click="StartService_Click"
                        Style="{StaticResource AccentButtonStyle}" />
                <Button Content="停止服务" Click="StopService_Click" />
                <Button Click="RefreshStatus_Click" ToolTipService.ToolTip="刷新状态">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- 主内容区：服务信息卡 -->
        <Grid Grid.Row="1">
            <Border Padding="16" CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <StackPanel Spacing="16">
                    <StackPanel Spacing="2">
                        <TextBlock Text="上次请求"
                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.LastRequestTime, Mode=OneWay}" FontSize="14" />
                    </StackPanel>

                    <StackPanel Spacing="2">
                        <TextBlock Text="服务端点"
                                   FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.Endpoint, Mode=OneWay}"
                                   FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" />
                    </StackPanel>

                    <Border Padding="10" CornerRadius="4"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                        <TextBlock Text="{x:Bind ViewModel.LastMessage, Mode=OneWay}"
                                   FontSize="12" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Border>

                    <!-- 开机自启开关 -->
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <ToggleSwitch x:Name="AutoStartToggle"
                                      Header="开机自启"
                                      IsOn="{x:Bind ViewModel.IsAutoStartEnabled, Mode=OneWay}"
                                      Toggled="AutoStartToggle_Toggled"
                                      MinWidth="0" />
                        <TextBlock x:Name="AutoStartHintText"
                                   Text="{x:Bind ViewModel.AutoStartHint, Mode=OneWay}"
                                   FontSize="12" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
